{
  "name": "odin-test-explorer",
  "displayName": "Odin Test Explorer",
  "description": "Discover and run Odin unit tests in VS Code's Test Explorer.",
  "publisher": "derekshoneycutt",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/derekshoneycutt/OdinVsCodeTests.git"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/*.odin"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Odin Test Explorer",
      "properties": {
        "odinTestExplorer.odinPath": {
          "type": "string",
          "default": "odin",
          "description": "Path to the Odin compiler executable."
        },
        "odinTestExplorer.testArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to odin test before runtime test arguments."
        },
        "odinTestExplorer.exclude": {
          "type": "string",
          "default": "**/{.git,node_modules,out,dist}/**",
          "description": "Glob pattern excluded from Odin test discovery."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --skip-license --out odin-test-explorer.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:helper": "odin test helper -define:ODIN_TEST_FANCY=false",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
